{
  "appId": "com.ayushlabroo.mrai",
  "productName": "MrAI",
  "electronVersion": "40.10.2",
  "asar": true,
  "forceCodeSigning": false,
  "directories": { "output": "release", "buildResources": "build" },
  "files": [
    "dist/**/*",
    "desktop/**/*",
    "package.json",
    "!**/.env*",
    "!**/.data/**",
    "!**/*.sqlite*"
  ],
  "mac": {
    "target": "dmg",
    "category": "public.app-category.productivity",
    "icon": "build/icon.icns",
    "identity": null,
    "notarize": false,
    "artifactName": "MrAI-${version}-mac-${arch}.${ext}"
  },
  "win": {
    "target": "nsis",
    "icon": "build/icon.ico",
    "artifactName": "MrAI-${version}-win-${arch}.${ext}"
  },
  "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
  "publish": null
}
