# Copy to .env.gateway. Never put provider keys in VITE_* variables or desktop files.
# Generate a random 32+ character client token and set ONLY its SHA-256 hash here.
AYRA_CLIENT_TOKEN_SHA256=REPLACE_WITH_SHA256_HEX_DIGEST
AYRA_LIVE_ENABLED=false
AYRA_MONTHLY_BUDGET_USD_MICROS=5000000
AYRA_MARKUP_BPS=10000
AYRA_GATEWAY_PORT=4318

# Set model IDs, verified full context ceilings, and current prices explicitly.
# No live model/pricing is selected by default. Examples are documented in README.
# Rates are integer USD millionths per million tokens ($1/M tokens = 1000000).
AYRA_MODELS_JSON=[]
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Desktop connection variables belong in the desktop process environment,
# not in the renderer and not in this gateway-only file:
# AYRA_GATEWAY_URL=http://127.0.0.1:4318
# AYRA_GATEWAY_TOKEN=<the original random client token, not its hash>
